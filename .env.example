# Public-facing example. Copy to .env.local and fill in real values.

# Admin dashboard access. Required.
ADMIN_ACCESS_KEY=generate-a-32-char-random-string-here

# Supabase project credentials. Required.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Billplz payment gateway. Optional in dev (booking still works with
# payment_method='manual'); required in production.
BILLPLZ_API_BASE_URL=https://www.billplz.com/api/v3
BILLPLZ_COLLECTION_ID=your-collection-id
BILLPLZ_SECRET_KEY=your-secret-key
BILLPLZ_X_SIGNATURE_KEY=your-x-signature-key

# Email provider (Resend). Optional — admin can resend invoices
# manually until this is configured.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Saga X Space <bookings@sagaxventures.com>
